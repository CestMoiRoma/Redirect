# Redirect task runner
#
# Lint, tests and GUI goldens always run in the pinned CI image (test/ci/Dockerfile), never on the host.
# `just ci` runs exactly what CI runs, in the same order: while CI has no runner, it is the gate.

ci_image := env("CI_IMAGE", "redirect-ci:local")
ci_platform := "linux/amd64"

# Run the app natively with auto-reload, data in ./data, on $PORT (8080)
run:
    DATA_DIR="${DATA_DIR:-./data}" uv run uvicorn redirect.main:app --reload --host 127.0.0.1 --port "${PORT:-8080}"

# Build (or pull, when CI_IMAGE is set) the CI image
ci-image:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ -n "${CI_IMAGE:-}" ]; then docker pull --quiet --platform {{ ci_platform }} "$CI_IMAGE" >/dev/null
    else docker build --quiet --platform {{ ci_platform }} -t {{ ci_image }} -f test/ci/Dockerfile test >/dev/null; fi

# Regenerate test/ci/requirements.lock after any requirements change (same Python image as the CI image)
ci-lock:
    #!/usr/bin/env bash
    set -euo pipefail
    base="$(awk '$1 == "FROM" && $2 ~ /^python:/ { print $2; exit }' test/ci/Dockerfile)"
    [ -n "$base" ] || { echo "No python base image in test/ci/Dockerfile" >&2; exit 1; }
    lock="$(docker run --rm --platform {{ ci_platform }} -v "$PWD/test":/test:ro "$base" sh -c \
      'pip install --quiet --disable-pip-version-check --root-user-action=ignore -r /test/ci/requirements.txt >&2 \
       && pip freeze --all --exclude pip --exclude setuptools --exclude wheel')"
    { echo "# Generated by just ci-lock: do not edit."; echo "$lock"; } > test/ci/requirements.lock

# Lint: every checker, nothing modified
lint: ci-image
    just _in-ci test/ci/lint.sh

# Format: apply the formatters
fmt: ci-image
    just _in-ci test/ci/lint.sh fix

# Full pipeline of one app (tests + goldens)
test APP: ci-image
    #!/usr/bin/env bash
    set -euo pipefail
    dir="$(just _test-dir '{{ APP }}')"
    just _in-ci "test/$dir/run-tests.sh"

# Regenerate the goldens of one app / of every app (commit them when the UI change is intended)
redirect-gui-goldens: (_gui-goldens "redirect")

all-gui-goldens: redirect-gui-goldens

# Fail if test/screenshot (or test/screenshot/APP) differs from HEAD
check-goldens APP="":
    test/ci/check-goldens.sh {{ APP }}

# Determinism proof: regenerate RUNS times and compare the bytes
gui-goldens-stability APP RUNS="3": ci-image
    #!/usr/bin/env bash
    set -euo pipefail
    dir="$(just _test-dir '{{ APP }}')"
    just _in-ci test/ci/goldens-stability.sh "$dir" {{ RUNS }}

# Exactly what CI runs, same image, same order (goldens are compared with HEAD: commit first)
ci: ci-image
    just _in-ci test/ci/lint.sh
    just _in-ci test/redirect/run-tests.sh tests
    just _in-ci test/redirect/run-tests.sh goldens
    test/ci/check-goldens.sh

_gui-goldens DIR: ci-image
    just _in-ci test/{{ DIR }}/run-tests.sh goldens

# Run in the CI image, repo on /repo, as the host user (files never become root-owned on Linux hosts)
_in-ci +CMD:
    docker run --rm --init --platform {{ ci_platform }} --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -v "$PWD":/repo -w /repo {{ ci_image }} {{ CMD }}

# App name -> test folder; exit 2 on an unknown app
_test-dir APP:
    #!/usr/bin/env bash
    case "{{ APP }}" in
      redirect|redirect/) echo "redirect" ;;
      *) echo "Unknown app: {{ APP }}" >&2; exit 2 ;;
    esac
